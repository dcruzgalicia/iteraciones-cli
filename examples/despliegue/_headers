# Cabeceras para sitios estáticos de iteraciones.
#
# Cloudflare Pages: copia este archivo a dist/files/_headers después del build.
# Netlify: traduce las reglas a [[headers]] en netlify.toml; ver
# docs/despliegue/netlify.md.
# GitHub Pages: no admite cabeceras personalizadas.
#
# Nota: la CLI no genera nombres hasheados para los assets. Por eso /assets/*
# usa max-age de un día con revalidación, no immutable.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
